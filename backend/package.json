{
  "name": "webnews-backend",
  "version": "0.1.0",
  "private": true,
  "description": "WebNEWS API server (Hono + Better Auth + Drizzle/PostgreSQL).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node --import tsx scripts/migrate.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:demo-admin-password": "node --import tsx scripts/demo-admin-password.ts",
    "db:admin-password": "node --import tsx scripts/admin-password.ts",
    "db:create": "node --import tsx scripts/db-create.ts",
    "db:clean-test": "node --import tsx scripts/clean-test.ts",
    "admin:verify": "node --import tsx scripts/admin-verify.ts",
    "admin:grant": "node --import tsx scripts/admin-grant.ts",
    "storage:sweep": "node --import tsx scripts/storage-sweep.ts",
    "media:to-r2": "node --import tsx scripts/media-to-r2.ts",
    "dummy:readers": "VITEST=1 node --import tsx scripts/dummy-readers.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@hono/node-server": "^2.1.1",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^13.10.0",
    "hono": "^4.13.9",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
