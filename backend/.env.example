# WebNEWS backend — copy to .env for local development. Real process env always wins over .env.
# In production set these in your hosting platform (Railway / Render / Fly / Docker) instead.

NODE_ENV=development                      # development | production | test
PORT=4000                                 # HTTP port
HOST=                                     # listen address; empty = 127.0.0.1 (this machine only), 0.0.0.0 in production

# PostgreSQL (postgres.js). No ?schema=... query options — the driver rejects them.
# This is the ONE database for the app, the seed and the automated tests. Tests never truncate or
# delete other data: they create "<random>@test.webnews.local" users and delete exactly those afterwards.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/webnews_platform

# Redis (optional): shared cache for hot reads (signed-out feeds, headlines, trending) so traffic spikes don't all
# hit Postgres. Empty = an in-process cache (fine for one server; use Redis when running several).
REDIS_URL=redis://localhost:6379

# Public origin of the web app (Better Auth baseURL, trusted origin, CORS origin, Google redirect base).
FRONTEND_URL=http://localhost:3000

BETTER_AUTH_SECRET=                       # openssl rand -base64 32   (min 32 chars)
COOKIE_DOMAIN=                            # optional, only for direct cross-subdomain deployments (e.g. .example.com)

# Client IP for rate limits: the number of trusted proxies in front of this API that APPEND to X-Forwarded-For
# (the client is the entry that many places from the right; client-written entries further left are ignored).
# 0 = ignore the header and use the socket address. Locally the web app (which drops browser-sent X-Forwarded-For
# and forwards the address it saw for server rendering) is the one hop: 1.
TRUST_PROXY=1

# Google sign-in (optional). Redirect URI to register: ${FRONTEND_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with LinkedIn (optional): a LinkedIn app with the "Sign In with LinkedIn using OpenID Connect" product.
# Redirect: ${FRONTEND_URL}/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Sign in with X (optional): developer.x.com → your app → User authentication settings (OAuth 2.0, type "Web App"),
# callback ${FRONTEND_URL}/api/auth/callback/twitter; then Keys and tokens → OAuth 2.0 Client ID and Client Secret.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Facebook login uses the same Meta app as auto-posting (META_APP_ID / META_APP_SECRET below) — add the "Facebook Login"
# product to it and register ${FRONTEND_URL}/api/auth/callback/facebook as a valid OAuth redirect.

# WhatsApp number check (readers verify their number once, then log in with number + password): the reader sends a
# ready-typed code to our business number on WhatsApp and Meta's webhook confirms who sent it. Meta WhatsApp Cloud API
# (developers.facebook.com → WhatsApp → API setup): the business number in digits (e.g. 919876543210), its "Phone
# number ID", a permanent System User access token. Webhook (WhatsApp → Configuration): callback URL
# ${FRONTEND_URL}/api/whatsapp/webhook, verify token = WHATSAPP_WEBHOOK_VERIFY_TOKEN, subscribe to "messages";
# META_APP_SECRET (below) signs the calls. Without these (development) every check passes by itself after a few seconds.
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Email (password reset links) through Resend (https://resend.com → API Keys). Without a key nothing is sent and, in
# development, the reset link is printed in this terminal. MAIL_FROM's domain must be verified in Resend
# (onboarding@resend.dev only delivers to your own Resend account's address).
RESEND_API_KEY=
MAIL_FROM=WebNEWS <onboarding@resend.dev>

# Cloudflare R2 (optional). When ALL five are set images go to R2, otherwise to LOCAL_UPLOAD_DIR.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=                       # e.g. https://media.yourdomain.com or https://pub-xxxx.r2.dev

LOCAL_UPLOAD_DIR=.data/uploads            # local driver only (relative to backend/); served at /media/*

# Press meets: reporters' recordings of the built-in room (private, replayed through the API — keep on a persistent disk).
RECORDINGS_DIR=.data/recordings
# Optional TURN relay for the press meet room (people behind strict office / mobile NATs). Comma-separated URLs.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Local testing only: 1 lets organizers start a press meet any time instead of 10 minutes before (ignored in production).
PRESS_MEET_START_ANYTIME=0

# Editor Desk (SPEC §3.11): comma-separated emails that become admins once the address is VERIFIED — automatically
# with "Continue with Google", or for a password account with `npm run admin:verify -- <email>` (sign-up sends no
# verification mail, so an unverified sign-up of a listed address stays a Reader). They still complete onboarding.
# Admins can promote others from the Editor Desk console.
ADMIN_EMAILS=admin@webnews.in

# Spotlight payments (not connected yet — every Spotlight request waits for the Editor Desk to grant it).
# The Razorpay provider is a stub that reads these once online payments are implemented.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

LOG_REQUESTS=1                            # 0 disables the per-request access log

# Auto-post to Instagram / Facebook Pages (Edit profile → Connected accounts, verified reporters) — docs/SOCIAL_AUTOPOST.md.
# One Meta app (developers.facebook.com): App ID + secret (App settings → Basic) and the Instagram app ID + secret
# (Instagram → API setup with Instagram login). Without them the Connect buttons say it's not switched on yet.
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# META_GRAPH_VERSION=v23.0

# Phone push notifications (Firebase Cloud Messaging). Firebase console → Project settings → Service accounts →
# "Generate new private key": put the file in backend/ (never commit it) and its name here, or paste the JSON into
# FIREBASE_SERVICE_ACCOUNT_JSON on hosts without files. Empty = no pushes (the bell still works).
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=
