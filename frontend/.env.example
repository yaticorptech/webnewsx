# WebNEWS frontend — copy to .env.local for local development.
# Real process env always wins over .env.local (Next.js loads .env files without overriding existing vars).

# Server-side only: target of the /api/* and /media/* rewrites AND of direct server fetches (lib/server-api.ts).
# Rewrites are baked in at build time, so set this for `next build` as well as at runtime.
BACKEND_URL=http://127.0.0.1:4000

# Public origin of this web app (absolute URLs, Open Graph, share links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Address put in profile QR codes and shared links: one a PHONE can open (the deployed https domain; in dev the
# phone relay, e.g. http://192.168.1.15:3100). Empty = the site URL (or the page's own address).
NEXT_PUBLIC_SHARE_URL=

# 1 when the backend has GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET set (shows "Continue with Google").
NEXT_PUBLIC_GOOGLE_ENABLED=0
# The backend's GOOGLE_CLIENT_ID (the Web application client): "Continue with Google" in the WebNEWS app
# (native account picker, mobile/README.md). Empty = the app offers email + password only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: direct SSE URL (e.g. https://api.example.com/api/stream) if a proxy buffers /api/stream.
# Its origin is added to the CSP connect-src. Empty = same-origin /api/stream through the rewrite.
NEXT_PUBLIC_STREAM_URL=

# Optional: extra image hosts for the CSP img-src, comma separated (e.g. the R2 public host
# https://media.example.com or https://pub-xxxx.r2.dev). Google avatars are always allowed.
NEXT_PUBLIC_MEDIA_HOSTS=

# Server-side only. 1 when an edge proxy in front of this app (Vercel, a load balancer) sets X-Forwarded-For.
# Otherwise (0 / empty, e.g. localhost) proxy.ts drops browser-sent X-Forwarded-For / X-Real-IP so nobody can
# pick their own rate-limit identity.
TRUST_PROXY=

# "Get the WebNEWS app" card in phone browsers (owner 2026-10-16): the Play Store link once the app is listed.
# Empty = the app file the phone relay serves (/webnews.apk).
NEXT_PUBLIC_ANDROID_APP_URL=
