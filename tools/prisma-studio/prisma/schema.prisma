  user_article_flag_user_idTouser     user      @relation("article_flag_user_idTouser", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "article_flag_user_id_user_id_fk")

  @@index([article_id, created_at(sort: Desc)], map: "article_flag_article_idx")
  @@index([status, created_at(sort: Desc)], map: "article_flag_status_created_idx")
}

model article_like {
  user_id    String
  article_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(3)
  article    article  @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "article_like_article_id_article_id_fk")
  user       user     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "article_like_user_id_user_id_fk")

  @@id([user_id, article_id], map: "article_like_user_id_article_id_pk")
  @@index([article_id], map: "article_like_article_idx")
  @@index([created_at], map: "article_like_created_idx")
}

model article_read {
  article_id String   @db.Uuid
  viewer_key String
  created_at DateTime @default(now()) @db.Timestamptz(3)
  article    article  @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "article_read_article_id_article_id_fk")

  @@id([article_id, viewer_key], map: "article_read_article_id_viewer_key_pk")
