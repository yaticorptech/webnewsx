datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model account {
  id                       String    @id
  account_id               String
  provider_id              String
  user_id                  String
  access_token             String?
  refresh_token            String?
  id_token                 String?
  access_token_expires_at  DateTime? @db.Timestamptz(6)
  refresh_token_expires_at DateTime? @db.Timestamptz(6)
  scope                    String?
  password                 String?
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @db.Timestamptz(6)
  user                     user      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "account_user_id_user_id_fk")

  @@index([user_id])
}

/// This model contains an index with non-default null sort order and requires additional setup for migrations. Visit https://pris.ly/d/default-index-null-ordering for more info.
model admin_audit_log {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id     String?
  action       String
  target_type  String
  target_id    String
  target_label String?
  meta         Json?
  created_at   DateTime @default(now()) @db.Timestamptz(3)
  user         user?    @relation(fields: [actor_id], references: [id], onUpdate: NoAction, map: "admin_audit_log_actor_id_user_id_fk")

  @@index([created_at(sort: Desc), id(sort: Desc)], map: "admin_audit_created_idx")
  @@index([target_type, target_id], map: "admin_audit_target_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an index with non-default null sort order and requires additional setup for migrations. Visit https://pris.ly/d/default-index-null-ordering for more info.
model article {
  id                             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id                      String
  status                         String              @default("draft")
  title                          String?
  body_html                      String?
  body_text                      String?
  excerpt                        String?
  cover_url                      String?
  cover_key                      String?
  cover_width                    Int?
  cover_height                   Int?
  cover_blur                     String?
  link_url                       String?
  link_domain                    String?
  slug                           String?             @unique(map: "article_slug_unique")
  reading_minutes                Int?
  view_count                     Int                 @default(0)
  like_count                     Int                 @default(0)
  share_count                    Int                 @default(0)
  created_at                     DateTime            @default(now()) @db.Timestamptz(3)
  updated_at                     DateTime            @default(now()) @db.Timestamptz(3)
  published_at                   DateTime?           @db.Timestamptz(3)
  submitted_at                   DateTime?           @db.Timestamptz(3)
  review_note                    String?
  reviewed_by                    String?
  reviewed_at                    DateTime?           @db.Timestamptz(6)
  returned_at                    DateTime?           @db.Timestamptz(6)
  hidden_at                      DateTime?           @db.Timestamptz(6)
  hidden_reason                  String?
  pinned_at                      DateTime?           @db.Timestamptz(6)
  pin_order                      Int?
  video_url                      String?
  video_key                      String?
  video_width                    Int?
  video_height                   Int?
  video_duration_ms              Int?
  category                       String?
  district                       String?
  comment_count                  Int                 @default(0)
  short_code                     String?             @unique(map: "article_short_code_unique")
  template                       String?
  poster_x                       Float?              @db.Real
  poster_y                       Float?              @db.Real
  poster_zoom                    Float?              @db.Real
  article_image_url              String?
  article_image_key              String?
  article_image_width            Int?
  article_image_height           Int?
  article_image_blur             String?
  article_video_url              String?
  article_video_key              String?
  article_video_width            Int?
  article_video_height           Int?
  article_video_duration_ms      Int?
  report_warned_at               DateTime?           @db.Timestamptz(6)
  report_locked_at               DateTime?           @db.Timestamptz(6)
  edited_at                      DateTime?           @db.Timestamptz(3)
  user_article_author_idTouser   user                @relation("article_author_idTouser", fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "article_author_id_user_id_fk")
  user_article_reviewed_byTouser user?               @relation("article_reviewed_byTouser", fields: [reviewed_by], references: [id], onUpdate: NoAction, map: "article_reviewed_by_user_id_fk")
  article_anon_like              article_anon_like[]
  article_comment                article_comment[]
  article_flag                   article_flag[]
  article_like                   article_like[]
  article_read                   article_read[]
  article_save                   article_save[]
  article_share                  article_share[]
  article_view                   article_view[]
  message                        message[]
  notification                   notification[]
  press_meet_invite              press_meet_invite[]
  social_post                    social_post[]
  spotlight_order                spotlight_order[]
  user_notice                    user_notice[]

  @@index([author_id, status, published_at(sort: Desc)], map: "article_author_status_published_idx")
  @@index([author_id, updated_at(sort: Desc)], map: "article_author_updated_idx")
  @@index([status, published_at(sort: Desc), id(sort: Desc)], map: "article_feed_idx")
  @@index([status, submitted_at], map: "article_review_idx")
}

model article_anon_like {
  viewer_id  String   @db.Uuid
  article_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(3)
  article    article  @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "article_anon_like_article_id_article_id_fk")

  @@id([viewer_id, article_id], map: "article_anon_like_viewer_id_article_id_pk")
  @@index([article_id], map: "article_anon_like_article_idx")
  @@index([created_at], map: "article_anon_like_created_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an index with non-default null sort order and requires additional setup for migrations. Visit https://pris.ly/d/default-index-null-ordering for more info.
model article_comment {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  article_id            String                 @db.Uuid
  author_id             String
  body                  String
  created_at            DateTime               @default(now()) @db.Timestamptz(3)
  parent_id             String?                @db.Uuid
  like_count            Int                    @default(0)
  article               article                @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "article_comment_article_id_article_id_fk")
  user                  user                   @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "article_comment_author_id_user_id_fk")
  article_comment       article_comment?       @relation("article_commentToarticle_comment", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "article_comment_parent_id_article_comment_id_fk")
  other_article_comment article_comment[]      @relation("article_commentToarticle_comment")
  article_comment_like  article_comment_like[]

  @@index([article_id, created_at(sort: Desc), id(sort: Desc)], map: "article_comment_article_created_idx")
  @@index([parent_id, created_at, id], map: "article_comment_parent_created_idx")
}

model article_comment_like {
  comment_id      String          @db.Uuid
  user_id         String
  created_at      DateTime        @default(now()) @db.Timestamptz(3)
  article_comment article_comment @relation(fields: [comment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "article_comment_like_comment_id_article_comment_id_fk")
  user            user            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "article_comment_like_user_id_user_id_fk")

  @@id([comment_id, user_id], map: "article_comment_like_comment_id_user_id_pk")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an index with non-default null sort order and requires additional setup for migrations. Visit https://pris.ly/d/default-index-null-ordering for more info.
model article_flag {
